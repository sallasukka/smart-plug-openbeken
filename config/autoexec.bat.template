// PFW02-G coffee maker – OpenBeken autoexec.bat
// Generated by scripts/deploy-autoexec.sh (don't edit on the device; change .env instead)

// --- Clock: NTP + Finnish time (EET, summer time EEST) ---
startDriver NTP
@NTP_LINE@
time_setTZ 2
// DST: last Sunday of March at 03:00 (+1 h), last Sunday of October at 04:00 (back)
TIME_setDST 0 3 1 3 1 0 10 1 4 0

// --- Auto-off ---
// When the relay turns on, schedule turning it off in @AUTO_OFF_MIN@ min.
// If the relay is turned off earlier, the timer is cancelled.
AddChangeHandler Channel1 == 1 addRepeatingEventUID @AUTO_OFF_SEC@ 1 10 setChannel 1 0
AddChangeHandler Channel1 == 0 cancelRepeatingEvent 10

// --- Morning timer ---
@MORNING_LINE@
